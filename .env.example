# ntfy.sh configuration
# Choose ANY hard-to-guess topic name (acts as a password). Subscribe to it
# from the ntfy app on your phone using the same value.
NTFY_TOPIC=my-whatsapp-9f7c1a-change-me

# Server URL. Use the public one or your own self-hosted instance.
NTFY_SERVER=https://ntfy.sh

# Optional: ntfy auth token / basic-auth if you protect your topic
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxx

# Local bridge HTTP API (used by the MCP server to send messages)
BRIDGE_PORT=3037
BRIDGE_HOST=127.0.0.1

# If you expose the bridge beyond localhost (e.g. behind an SSH tunnel from a
# VM), set BRIDGE_HOST=0.0.0.0 AND a long random BRIDGE_TOKEN. Then set the
# same BRIDGE_TOKEN in the environment of any MCP client that connects.
# BRIDGE_TOKEN=

# Path to Chromium when running on Linux/Docker (whatsapp-web.js will use its
# bundled Chromium otherwise). On Debian/Ubuntu after `apt install chromium`:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Notification filtering
# Comma-separated chat IDs / names to MUTE (e.g. "Status@broadcast,Spam Group")
MUTE_CHATS=
# If set to "true", only DM (1:1) messages are forwarded; group messages are ignored
ONLY_DIRECT=false
# If set to "true", forward your own outbound messages too (default: false)
INCLUDE_FROM_ME=false

# SQLite database path (relative to project root)
DB_PATH=./data/whatsapp.db

# Path where whatsapp-web.js stores its session (so you don't re-scan QR each run)
SESSION_PATH=./data/wa-session
