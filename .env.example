# ntfy.sh configuration
# Choose ANY hard-to-guess topic name (acts as a password). Subscribe to it
# from the ntfy app on your phone using the same value.
NTFY_TOPIC=my-whatsapp-9f7c1a-change-me

# Server URL. Use the public one or your own self-hosted instance.
NTFY_SERVER=https://ntfy.sh

# Optional: ntfy auth token / basic-auth if you protect your topic
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxx

# Local bridge HTTP API (used by the MCP server to send messages)
BRIDGE_PORT=3037
BRIDGE_HOST=127.0.0.1

# If you expose the bridge beyond localhost (e.g. behind an SSH tunnel from a
# VM), set BRIDGE_HOST=0.0.0.0 AND a long random BRIDGE_TOKEN. Then set the
# same BRIDGE_TOKEN in the environment of any MCP client that connects.
# BRIDGE_TOKEN=

# Path to Chromium when running on Linux/Docker (whatsapp-web.js will use its
# bundled Chromium otherwise). On Debian/Ubuntu after `apt install chromium`:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Notification filtering
# Comma-separated chat IDs / names to MUTE (e.g. "Status@broadcast,Spam Group")
MUTE_CHATS=
# If set to "true", only DM (1:1) messages are forwarded; group messages are ignored
ONLY_DIRECT=false
# If set to "true", forward your own outbound messages too (default: false)
INCLUDE_FROM_ME=false

# SQLite database path (relative to project root)
DB_PATH=./data/whatsapp.db

# Path where whatsapp-web.js stores its session (so you don't re-scan QR each run)
SESSION_PATH=./data/wa-session

# Where downloaded media (images, voice notes, etc.) is stored
MEDIA_DIR=./data/media

# ----------------------------------------------------------------------
# Anthropic API — used for smart priority, suggested replies, image OCR.
# All AI features are best-effort: if calls fail, notifications still flow.
# ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Fast/cheap model for priority scoring (one call per incoming message)
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Smarter model for suggested replies + image description
ANTHROPIC_MODEL_SMART=claude-sonnet-4-6

# Feature toggles (each can be flipped off without touching code)
AI_PRIORITY_ENABLED=true
AI_REPLIES_ENABLED=true
AI_VISION_ENABLED=true

# Only push to phone if Claude's priority >= this value.
# Valid: low | normal | urgent. Use "low" to push everything (just labeled).
AI_PRIORITY_FLOOR=low

# Suggested replies are skipped for groups by default (too noisy).
AI_REPLIES_IN_GROUPS=false

# Group burst summary: when multiple messages arrive in a group within
# AI_BURST_WINDOW_MS, hold them and push a SINGLE Claude-summarized
# notification instead of one ping per message. Cuts noise on busy chats.
AI_BURST_ENABLED=true
AI_BURST_WINDOW_MS=30000
# Hard cap — flush early if this many messages buffer before the window expires.
AI_BURST_MAX_BUFFER=20

# ----------------------------------------------------------------------
# ntfy action buttons (tap-to-reply) and image attachments.
# The ntfy app on your phone calls back into the bridge for replies, so
# PUBLIC_BRIDGE_URL must be reachable from your phone (or from ntfy.sh's
# servers for image attachments). Leave both blank to disable.
# ----------------------------------------------------------------------
ACTION_TOKEN=
PUBLIC_BRIDGE_URL=
